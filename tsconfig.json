{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node", "vite-plus/test/globals"],
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "test", "vite.config.ts", "docs/.vitepress/**/*.ts", "docs/examples/*.ts"]
}
